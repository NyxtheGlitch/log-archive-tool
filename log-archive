#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 1 ]; then
    echo "Usage: log-archive <log-directory>" >&2
    exit 1
fi

LOG_DIR="$1"

if [ ! -d "$LOG_DIR" ]; then
    echo "Error: '$LOG_DIR' is not a directory." >&2
    exit 1
fi

ARCHIVE_DIR="${LOG_ARCHIVE_DIR:-$HOME/log-archives}"
mkdir -p "$ARCHIVE_DIR"

TIMESTAMP=$(date +%Y%m%d_%H%M%S)
ARCHIVE_NAME="logs_archive_${TIMESTAMP}.tar.gz"
ARCHIVE_PATH="${ARCHIVE_DIR}/${ARCHIVE_NAME}"
if [ -e "$ARCHIVE_PATH" ]; then
    echo "Error: $ARCHIVE_PATH already exists. Wait a second and retry." >&2
    exit 1
fi

trap 'rm -f "$ARCHIVE_PATH"' ERR
tar -czf "$ARCHIVE_PATH" -C "$LOG_DIR" .
trap - ERR

LOG_FILE="${ARCHIVE_DIR}/archive.log"
echo "$(date '+%Y-%m-%d %H:%M:%S') archived ${LOG_DIR} -> ${ARCHIVE_NAME}" >> "$LOG_FILE"

echo "Created $ARCHIVE_PATH"